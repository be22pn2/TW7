# Copie este arquivo para ".env" e preencha os valores
# Este arquivo contém segredos. NUNCA o envie para o GitHub.

# Remetente (a conta Gmail que enviará os e-mails)
SMTP_USER=seuemail@gmail.com

# Senha de app do Gmail (crie em: https://myaccount.google.com/apppasswords)
# Obs.: é necessário ter a Verificação em 2 etapas ativada na conta.
SMTP_PASS=sua-senha-de-app

# Destinatário (para onde vão as solicitações do formulário)
RECIPIENT_EMAIL=tw7group@gmail.com

# Porta (use 3000 em desenvolvimento, ou omita para usar o padrão)
PORT=3000